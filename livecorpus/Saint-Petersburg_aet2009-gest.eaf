        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7"
                TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts29">
                <ANNOTATION_VALUE>я выбрала выcшую школу экономики</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8"
                TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts133">
                <ANNOTATION_VALUE>потому что / у меня не осталось других вариантов / потому что яя / хотела / вообще / в Питере учиться / я никогда не думала / что я поеду в Москву учиться / потому что</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15"
                TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts139">
                <ANNOTATION_VALUE>ц</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16"
                TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts181">
                <ANNOTATION_VALUE>Питер это моя кровинушка любимая / мой город / и я оттуда уезжать не собиралась</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a17"
                TIME_SLOT_REF1="ts182" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>вот / я= и я бы никогда не подумала / что у меня не будет / такого / что мне негде учиться в Питере</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19"
                TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>но / оказалось / что / в Питере нет нормальной лингвистики</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20"
                TIME_SLOT_REF1="ts281" TIME_SLOT_REF2="ts345">
                <ANNOTATION_VALUE>вот / ээ / ну я когда в десятом классе начала /  ээ / делать ресёрчи всякие / сатреть / где вообще / можно лингвистике поучиться</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a23"
                TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts365">
                <ANNOTATION_VALUE>нашла / что есть / в вышке </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
